rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the user's role from the 'users' collection.
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      // Allow users to read their own user document.
      allow read: if request.auth.uid == userId;
      // Allow users to create their own user document upon signup.
      allow create: if request.auth.uid == userId;
    }

    // Rules for the 'operators' collection.
    match /operators/{operatorId} {
      // Allow authenticated users to read and write to the operators collection.
      allow read, write: if request.auth != null;
    }

    // Rules for the 'styles' collection.
    match /styles/{styleId} {
        // Allow authenticated users to read and write to the styles collection.
        allow read, write: if request.auth != null;
    }

    // Rules for other collections (e.g., production data, etc.)
    // These can be further restricted based on user roles (admin, supervisor, operator).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
