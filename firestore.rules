rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isSupervisor() {
      return userRole() == 'supervisor';
    }

    function isOperator() {
      return userRole() == 'operator';
    }

    function isPlanner() {
      return isAdmin() || isSupervisor();
    }

    function isStaff() {
      return isAdmin() || isSupervisor() || isOperator();
    }

    function roleIsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isPlanner());
      allow list: if isPlanner();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'operator';
      allow update: if signedIn()
        && (
          isAdmin()
          || (request.auth.uid == userId && roleIsUnchanged())
        );
      allow delete: if isAdmin();
    }

    match /operators/{operatorId} {
      allow read: if isPlanner();
      allow write: if isAdmin();
    }

    match /styles/{styleId} {
      allow read: if isStaff();
      allow write: if isPlanner();
    }

    match /production/{entryId} {
      allow get: if isPlanner() || (signedIn() && resource.data.operatorId == request.auth.uid);
      allow list: if isPlanner();
      allow create: if isPlanner()
        || (signedIn() && request.resource.data.operatorId == request.auth.uid);
      allow update, delete: if isPlanner();
    }

    match /daily_plans/{planId} {
      allow read: if isStaff();
      allow write: if isPlanner();
    }

    match /configuration/{configId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
